# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Authentication
AUTH_USERNAME=pufferfish
AUTH_PASSWORD=pufferfish

# Domain Filter
# Comma-separated list of allowed domains
DOMAIN_FILTER_ALLOWLIST=www.easyfun.gg

# Comma-separated list of blocked domains
DOMAIN_FILTER_BLOCKLIST=localhost,127.0.0.1

# Logging
LOGGING_LEVEL=info
LOGGING_FORMAT=pretty
LOGGING_LOG_REQUESTS=true
